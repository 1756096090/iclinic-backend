%% =============================================================================
%% Arquitectura objetivo iClinic
%%
%% FUENTE DE VERDAD: los scripts SQL validados contra PostgreSQL 16.13
%%   iclinic-core-schema.sql   -> secciones 1 a 7 de este diagrama
%%   iclinic-authz-schema.sql  -> seccion 4 (autorizacion)
%%   iclinic-rls.sql           -> aislamiento, no se dibuja
%% Este .mmd es la vista, no el contrato. Si difieren, manda el SQL.
%%
%% Las secciones 8 a 10 (CRM, modulos, campanas) NO estan congeladas en SQL
%% todavia: se conservan de la revision anterior y estan marcadas.
%%
%% ----------------------------------------------------------------------------
%% CAMBIO DE FONDO: KEYCLOAK
%% ----------------------------------------------------------------------------
%% La identidad sale de la base de datos. Reparto de responsabilidades:
%%
%%   Keycloak    autenticacion, MFA, sesiones, refresh, roles de cliente,
%%               service accounts. Es el duenno del sujeto.
%%   PostgreSQL  datos del dominio, aislamiento por RLS, integridad por FK
%%               compuestas, invariantes por EXCLUDE y triggers.
%%   Spring Boot autorizacion de negocio: AuthorizationService, que es la
%%               traduccion en Java de authz_patient_read_path().
%%
%% Consecuencias sobre el modelo anterior:
%%
%%   - users deja de ser una credencial y pasa a ser la PROYECCION del sujeto
%%     de Keycloak: keycloak_user_id uuid UNIQUE, subject_type HUMAN o
%%     SERVICE_ACCOUNT. NO hay password_hash. NO hay external_auth_id de
%%     Firebase. Anade tokens_valid_from como kill-switch de sesiones vivas.
%%
%%   - Desaparecen principals, role_definitions, role_assignments,
%%     access_policies y permission_catalog. El modelo ABAC con condiciones
%%     compiladas a SQL se sustituye por algo que ya esta escrito y probado:
%%       organization_members        pertenencia al tenant
%%       organization_member_roles   N roles por miembro, enum cerrado
%%       member_branches             ambito por sucursal, con vigencia
%%       practitioner_branches       donde ejerce, con vigencia
%%       patient_care_team           relacion clinica declarada
%%       appointments                relacion clinica derivada
%%       access_grants               SOLO la excepcion, siempre con caducidad
%%     La pregunta "puede este miembro leer a este paciente" la responde la
%%     funcion authz_patient_read_path, que devuelve LA VIA (ORG_ADMIN,
%%     BRANCH_MANAGER, CARE_TEAM, APPOINTMENT, GRANT_PATIENT, GRANT_SCOPE)
%%     para poder auditarla, no un booleano.
%%
%%   - Aparecen practitioners y patients como tablas propias, colgando de
%%     persons. La faceta deja de ser una fila generica de role_assignments y
%%     pasa a ser una tabla con lo que cada faceta necesita de verdad:
%%     licencia y especialidades el profesional, numero de historia el paciente.
%%
%%   - El ambito jerarquico por scope_path desaparece. No hay materialized path
%%     que mantener sincronizado ni indice text_pattern_ops: el ambito son FK
%%     compuestas reales (organization_id, branch_id) y la jerarquia la
%%     recorren los JOIN.
%%
%% ----------------------------------------------------------------------------
%% CONVENCIONES QUE NO SE DIBUJAN
%% ----------------------------------------------------------------------------
%%   - created_at / updated_at timestamptz NOT NULL DEFAULT now() en toda tabla.
%%     SIEMPRE timestamptz: el "hoy" se calcula en branches.timezone.
%%   - version int NOT NULL DEFAULT 0 para bloqueo optimista en toda tabla
%%     mutable por usuario.
%%   - deleted_at timestamptz para baja logica. EXCEPCION: clinical_records y
%%     audit_logs NO la tienen, son append-only de verdad.
%%   - organization_id en toda tabla tenant-scoped, con politica RLS generada
%%     en bucle sobre esa columna. Fuera por no ser tenant-scoped, y son las
%%     unicas cuatro: organizations (es el tenant), users (proyeccion global
%%     de Keycloak), specialties y modules (catalogos globales).
%%   - UNIQUE (organization_id, id) en todo padre tenant-scoped: es la clave
%%     candidata que respalda las FK compuestas. Una FK de N columnas exige un
%%     UNIQUE de EXACTAMENTE esas N columnas.
%%
%% ----------------------------------------------------------------------------
%% DECISION BLOQUEANTE: organizations O companies, no las dos
%% ----------------------------------------------------------------------------
%% El SQL validado dice organizations / organization_members /
%% organization_member_roles. El §0 del prompt de migracion dice, literal:
%% "DECISION TOMADA: se mantiene company. NO renombres Company->Organization".
%% Se contradicen. Este diagrama usa los nombres del SQL porque es el artefacto
%% validado; si gana `company`, la sustitucion es mecanica y afecta a todo.
%% Ver MIGRATION_PLAN.md §10.1.
%% =============================================================================

erDiagram
    %% ========== 1. TENENCIA ==========
    organizations {
        bigint id PK "EL TENANT"
        uuid keycloak_organization_id UK "nullable"
        varchar name
        varchar slug UK
        varchar plan
        varchar status "ACTIVE"
    }
    legal_entities {
        bigint id PK
        bigint organization_id FK "UNIQUE org+id"
        char country_code "EC CO"
        varchar legal_name
        char currency_code
        jsonb fiscal_config
    }
    legal_entity_tax_ids {
        bigint id PK
        bigint organization_id FK
        bigint legal_entity_id FK "FK compuesta org+le"
        varchar tax_id_type "RUC NIT EIN"
        varchar tax_id_value
    }
    branches {
        bigint id PK
        bigint organization_id FK "UNIQUE org+id y org+le+id"
        bigint legal_entity_id FK "FK compuesta org+le"
        varchar branch_type
        varchar name
        varchar timezone "IANA - define el HOY - CHECK de formato"
        boolean has_laboratory
    }
    bookable_resources {
        bigint id PK "sillon, sala"
        bigint organization_id FK "UNIQUE org+branch+id"
        bigint branch_id FK "FK compuesta org+branch"
        varchar resource_type "CHAIR ROOM"
        varchar name
    }

    %% ========== 2. PERSONAS ==========
    persons {
        bigint id PK "el humano"
        bigint organization_id FK "UNIQUE org+id"
        varchar first_name
        varchar last_name
        date birth_date
        bigint merged_into_id FK "FK compuesta: no se fusiona entre tenants"
    }
    person_identifiers {
        bigint id PK
        bigint organization_id FK
        bigint person_id FK "FK compuesta org+person"
        varchar id_type "CEDULA PASSPORT"
        varchar id_value "UNIQUE parcial org+type+value"
    }
    person_phones {
        bigint id PK
        bigint organization_id FK
        bigint person_id FK "FK compuesta org+person"
        varchar normalized_phone "CHECK E164 - UNIQUE parcial org+person+phone"
        boolean whatsapp_capable
        boolean is_primary
    }
    person_emails {
        bigint id PK
        bigint organization_id FK
        bigint person_id FK "FK compuesta org+person"
        varchar email
        varchar email_normalized "GENERATED lower(email) - UNIQUE parcial"
        boolean verified
    }

    %% ========== 3. IDENTIDAD: PROYECCION DE KEYCLOAK ==========
    users {
        bigint id PK "NO tenant-scoped - NO hay RLS aqui"
        uuid keycloak_user_id UK "el sub de Keycloak - fuente de verdad"
        varchar subject_type "CHECK HUMAN o SERVICE_ACCOUNT"
        varchar keycloak_client_id "azp - obligatorio si SERVICE_ACCOUNT"
        varchar display_name
        varchar email "copia de conveniencia, no credencial"
        varchar status
        timestamptz tokens_valid_from "kill-switch: jwt.iat menor = 401"
    }
    organization_members {
        bigint id PK "LA PUERTA DEL TENANT"
        bigint organization_id FK "UNIQUE org+id"
        bigint user_id FK "UNIQUE org+user"
        bigint person_id FK "nullable - UNIQUE org+person - FK compuesta"
        varchar status
        timestamptz joined_at
    }
    organization_member_roles {
        bigint organization_id PK "PK org+member+role"
        bigint member_id PK "FK compuesta, ON DELETE CASCADE"
        varchar role_code PK "CHECK enum cerrado - N roles por miembro"
        bigint granted_by_user_id FK
        timestamptz granted_at
    }
    member_branches {
        bigint organization_id PK "PK org+member+branch"
        bigint member_id PK "FK compuesta"
        bigint branch_id PK "FK compuesta - no cruza tenant"
        timestamptz valid_from
        timestamptz valid_until "NULL = permanente"
        timestamptz revoked_at
        bigint revoked_by_user_id FK
        varchar revocation_reason
    }
    service_account_grants {
        bigint organization_id PK "PK org+user"
        bigint user_id PK "un SERVICE_ACCOUNT de Keycloak"
        text scopes "text[] - CHECK cardinality mayor que 0"
        bigint legal_entity_id FK "nullable - FK compuesta"
        varchar status
    }

    %% ========== 4. FACETAS: PROFESIONAL Y PACIENTE ==========
    practitioners {
        bigint id PK "la faceta que ejerce"
        bigint organization_id FK "UNIQUE org+id y org+person"
        bigint person_id FK "FK compuesta org+person"
        varchar license_number "UNIQUE parcial org+country+number"
        char license_country
        varchar license_status
        varchar status
    }
    specialties {
        varchar code PK "catalogo GLOBAL - sin organization_id, sin RLS"
        varchar name
        varchar discipline
    }
    practitioner_specialties {
        bigint organization_id PK "PK org+prac+specialty"
        bigint practitioner_id PK "FK compuesta, ON DELETE CASCADE"
        varchar specialty_code PK "FK a specialties"
        boolean is_primary
    }
    practitioner_branches {
        bigint organization_id PK "PK org+prac+branch - donde ejerce"
        bigint practitioner_id PK "FK compuesta"
        bigint branch_id PK "FK compuesta"
        boolean is_primary
        timestamptz valid_from
        timestamptz valid_until "NULL = permanente"
        timestamptz revoked_at
        bigint revoked_by_user_id FK
        varchar revocation_reason
    }
    patients {
        bigint id PK "la faceta que se atiende"
        bigint organization_id FK "UNIQUE org+id y org+person"
        bigint person_id FK "FK compuesta org+person"
        varchar medical_record_number "UNIQUE org+mrn"
        bigint primary_branch_id FK "nullable - FK compuesta"
        varchar status
    }
    patient_care_team {
        bigint organization_id PK "PK org+patient+prac+role"
        bigint patient_id PK "FK compuesta"
        bigint practitioner_id PK "FK compuesta"
        varchar care_role PK "CHECK PRIMARY TREATING ASSISTING"
        timestamptz valid_from
        timestamptz valid_until "CHECK: PRIMARY no admite caducidad"
        timestamptz revoked_at
        bigint revoked_by_user_id FK
    }
    access_grants {
        bigint id PK "SOLO la excepcion, nunca el acceso normal"
        bigint organization_id FK
        bigint grantee_member_id FK "FK compuesta a organization_members"
        bigint patient_id FK "nullable - FK compuesta"
        bigint branch_id FK "nullable - FK compuesta - CHECK excluyentes"
        varchar scope_kind "GENERATED PATIENT BRANCH u ORGANIZATION"
        varchar permission "CHECK enum - clinical.sign NO se delega"
        varchar reason_code "CHECK enum - ORGANIZATION solo AUDIT o SUPPORT"
        varchar justification "CHECK longitud minima 10"
        bigint granted_by_user_id FK
        timestamptz valid_from
        timestamptz valid_until "CHECK obligatoria salvo COVERAGE"
        tstzrange validity "GENERATED - EXCLUDE antiduplicados"
        timestamptz revoked_at
        bigint revoked_by_user_id FK
        varchar revocation_reason
    }

    %% ========== 5. AGENDA ==========
    service_types {
        bigint id PK
        bigint organization_id FK "UNIQUE org+id"
        bigint legal_entity_id FK "FK compuesta"
        varchar name
        int default_duration_minutes "CHECK 5 a 600"
        int buffer_after_minutes "CHECK 0 a 240"
        boolean requires_laboratory
    }
    practitioner_schedules {
        bigint id PK
        bigint organization_id FK
        bigint practitioner_id FK "FK compuesta a practitioner_branches"
        bigint branch_id FK "el trio org+prac+branch debe existir"
        smallint day_of_week "CHECK 1 a 7"
        timerange work_period "hora de pared - tipo RANGE propio"
        daterange validity "horario versionado"
    }
    schedule_exceptions {
        bigint id PK
        bigint organization_id FK
        bigint practitioner_id FK "NULL = toda la sucursal"
        bigint branch_id FK "FK compuesta"
        varchar exception_type "CHECK BLOCK EXTRA_SHIFT HOLIDAY"
        tstzrange period
        varchar reason
    }
    appointments {
        bigint id PK
        bigint organization_id FK
        bigint legal_entity_id FK "FK triple org+le+branch: no se contradicen"
        bigint branch_id FK
        bigint patient_id FK "FK compuesta - la faceta, no la persona"
        bigint practitioner_id FK "FK triple: debe ejercer en esa sucursal"
        bigint service_type_id FK "FK compuesta"
        bigint resource_id FK "nullable - FK triple org+branch+resource"
        tstzrange slot "la cita - EXCLUDE de paciente y de sillon"
        int buffer_after_minutes "CHECK 0 a 240"
        tstzrange slot_blocking "slot + buffer - EXCLUDE de profesional"
        timestamptz scheduled_start "GENERATED lower(slot)"
        varchar status "CHECK 7 estados"
        timestamptz attended_at "CHECK solo IN_PROGRESS o COMPLETED"
    }
    appointment_events {
        bigint id PK
        bigint organization_id FK
        bigint appointment_id FK
        varchar event
        bigint actor_user_id FK "nullable si SYSTEM"
        varchar actor_type "CHECK HUMAN SERVICE_ACCOUNT SYSTEM"
        varchar channel
        jsonb payload
        timestamptz occurred_at
    }

    %% ========== 6. HISTORIA CLINICA ==========
    clinical_records {
        bigint id PK "APPEND-ONLY: sin deleted_at, trigger prohibe DELETE"
        bigint organization_id FK
        bigint legal_entity_id FK "FK triple con branch"
        bigint branch_id FK "sin esto el ambito de sucursal no filtra"
        bigint patient_id FK "UNIQUE org+patient+id - ancla la historia"
        bigint appointment_id FK "contexto - nullable"
        bigint author_user_id FK "quien lo escribio"
        bigint author_practitioner_id FK "nullable - FK compuesta"
        jsonb content
        varchar record_type
        int content_schema_version "CHECK mayor o igual a 1"
        char content_hash "sha256"
        bytea content_signature "firma real, no solo hash"
        varchar signature_key_id
        varchar signature_alg
        timestamptz signed_at "firmado = inmutable por trigger"
        bigint amends_record_id FK "UNIQUE: la cadena no se bifurca"
    }

    %% ========== 7. AUDITORIA ==========
    audit_logs {
        bigint id PK "PK compuesta occurred_at+id - PARTICIONADA POR MES"
        timestamptz occurred_at PK "la clave de particion"
        bigint organization_id FK "nullable: acciones de plataforma"
        bigint legal_entity_id FK
        bigint branch_id FK
        varchar actor_type "CHECK HUMAN SERVICE_ACCOUNT SYSTEM"
        uuid actor_subject "el sub de Keycloak - vale para humano y servicio"
        bigint actor_user_id "join comodo, no la fuente de verdad"
        varchar actor_client_id "azp del service account"
        bigint on_behalf_of_user_id "suplantacion de soporte"
        varchar action
        varchar entity_type
        bigint entity_id
        varchar outcome "CHECK ALLOW DENY ERROR - el DENY es lo que detecta sondeos"
        varchar deny_reason
        uuid request_id
        varchar session_id
        inet ip_address
        varchar user_agent
        jsonb metadata "incluye la VIA de concesion"
    }

    %% ========== 8. CRM OMNICANAL (NO congelado en SQL) ==========
    crm_channel_connections {
        bigint id PK
        bigint organization_id FK
        bigint legal_entity_id FK "el numero es de una sociedad"
        varchar channel_type "WHATSAPP TELEGRAM MESSENGER"
        varchar external_account_id "UNIQUE type+account - una cuenta, un tenant"
        varchar access_token_encrypted "AES-GCM, clave por entorno"
        uuid webhook_token UK
        varchar status
    }
    channel_connection_branches {
        bigint organization_id FK
        bigint connection_id FK
        bigint branch_id FK
    }
    crm_contacts {
        bigint id PK
        bigint organization_id FK
        bigint person_id FK "nullable hasta identificar - NO es el paciente"
        varchar display_name
        varchar status "LEAD ACTIVE ARCHIVED"
    }
    crm_channel_user_links {
        bigint id PK
        bigint organization_id FK "sin esto se fugan contactos entre tenants"
        bigint contact_id FK
        varchar channel_type
        varchar external_user_id "UNIQUE org+type+user"
        varchar external_chat_id "destino de envio"
        varchar username
        varchar display_name
    }
    teams {
        bigint id PK
        bigint organization_id FK
        varchar name
    }
    team_members {
        bigint id PK
        bigint organization_id FK
        bigint team_id FK
        bigint member_id FK "UNIQUE team+member - organization_members"
    }
    crm_conversations {
        bigint id PK
        bigint organization_id FK
        bigint contact_id FK
        bigint channel_connection_id FK
        bigint assigned_member_id FK "organization_members, no users"
        bigint team_id FK
        varchar status "OPEN PENDING CLOSED"
        timestamptz window_expires_at "ventana 24h de Meta"
    }
    crm_messages {
        bigint id PK
        bigint organization_id FK
        bigint conversation_id FK
        bigint channel_connection_id FK "denormalizado - idempotencia"
        bigint sent_by_user_id FK
        varchar direction "IN OUT"
        varchar external_message_id "UNIQUE conn+external_id"
        text content "viaja dato de salud - decision de cifrado abierta"
    }
    crm_message_events {
        bigint id PK
        bigint organization_id FK
        bigint message_id FK
        varchar event "UNIQUE msg+event"
        timestamptz occurred_at
    }
    crm_message_attachments {
        bigint id PK
        bigint organization_id FK
        bigint message_id FK
        varchar media_url
        varchar mime_type
    }
    contact_consents {
        bigint id PK
        bigint organization_id FK
        bigint contact_id FK
        varchar channel_type "el opt-out es por canal"
        varchar purpose "MARKETING TRANSACTIONAL"
        varchar status "GRANTED REVOKED"
        timestamptz occurred_at
    }

    %% ========== 9. MODULOS (NO congelado en SQL) ==========
    modules {
        varchar code PK "catalogo global - sin RLS"
        varchar name
        varchar min_plan
    }
    company_modules {
        bigint organization_id FK
        varchar module_code FK
        boolean enabled
        jsonb limits
    }

    %% ========== 10. CAMPANAS (NO congelado en SQL) ==========
    segments {
        bigint id PK
        bigint organization_id FK
        jsonb filter "compila a SQL con operadores cerrados"
    }
    message_templates {
        bigint id PK
        bigint organization_id FK
        varchar external_name "aprobada en Meta"
        varchar language_code "UNIQUE org+name+language"
        jsonb variables
        varchar approval_status
    }
    campaigns {
        bigint id PK
        bigint organization_id FK
        bigint legal_entity_id FK
        bigint segment_id FK
        bigint template_id FK
        varchar status
        int throttle_per_minute
        varchar timezone "ancla de quiet_hours"
        jsonb quiet_hours
    }
    campaign_channels {
        bigint organization_id FK
        bigint campaign_id FK
        bigint channel_connection_id FK
    }
    campaign_recipients {
        bigint id PK
        bigint organization_id FK
        bigint campaign_id FK
        bigint contact_id FK "UNIQUE campaign+contact"
        bigint message_id FK "nullable hasta enviar"
        varchar status "PENDING SENT SKIPPED_OPTOUT"
    }

    %% ===== RELACIONES =====
    %% organization_id denormalizado NO se dibuja: son ~35 aristas de ruido.
    %%
    %% NO son relaciones, aunque lo parezcan:
    %%   - practitioner_schedules no apunta a appointments. Que una cita quepa
    %%     en el horario se valida al agendar; no hay FK.
    %%   - schedule_exceptions no apunta a practitioner_schedules. La resta de
    %%     disponibilidad se calcula.
    %%   - authz_patient_read_path() no es una tabla: es la consulta canonica
    %%     que recorre member_branches, patient_care_team, appointments y
    %%     access_grants, y devuelve la via.
    organizations ||--o{ legal_entities : ""
    organizations ||--o{ persons : ""
    organizations ||--o{ organization_members : ""
    organizations ||--o{ service_account_grants : ""
    organizations ||--o{ teams : ""
    organizations ||--o{ segments : ""
    organizations ||--o{ company_modules : ""
    organizations ||--o{ audit_logs : ""
    legal_entities ||--o{ legal_entity_tax_ids : ""
    legal_entities ||--o{ branches : ""
    legal_entities ||--o{ service_types : ""
    legal_entities ||--o{ crm_channel_connections : ""
    legal_entities ||--o{ campaigns : ""
    branches ||--o{ bookable_resources : ""
    branches ||--o{ practitioner_branches : ""
    branches ||--o{ member_branches : ""
    branches ||--o{ practitioner_schedules : ""
    branches ||--o{ schedule_exceptions : ""
    branches ||--o{ appointments : ""
    branches ||--o{ clinical_records : "donde se atendio"
    branches ||--o{ channel_connection_branches : ""
    branches |o--o{ patients : "sucursal habitual"

    persons ||--o{ person_identifiers : ""
    persons ||--o{ person_phones : ""
    persons ||--o{ person_emails : ""
    persons |o--o| persons : "merged_into_id, dentro del mismo tenant"
    persons |o--o| organization_members : "si ademas loguea"
    persons |o--o| practitioners : "faceta profesional"
    persons |o--o| patients : "faceta paciente"

    users ||--o{ organization_members : "una credencial, N organizaciones"
    users ||--o{ service_account_grants : "service account"
    organization_members ||--o{ organization_member_roles : "N roles"
